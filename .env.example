# Copy to .env (never committed) and pass to Harbor with --env-file .env

# Local llama.cpp / vLLM server (default shown)
HARNESS_LOCAL_BASE_URL=http://127.0.0.1:8080/v1

# NVIDIA API catalog (free tier): https://build.nvidia.com
NVIDIA_API_KEY=

# Any other OpenAI-compatible endpoint
HARNESS_BASE_URL=
HARNESS_API_KEY=
